# ONRAMP local configuration example. Copy to .env and fill in.
# The Settings / API keys page writes these values for you; you can also edit
# by hand. The .env file is git-ignored - never commit real keys.

# --- Active LLM provider selection -----------------------------------------
# One of: huggingface | nvidia | openrouter | openai
ONRAMP_PROVIDER=huggingface
# Model id for the selected provider (see the Settings page for guidance).
ONRAMP_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Provider API keys (set only the one(s) you use) -----------------------
# Hugging Face Inference Router (OpenAI-compatible). Token: https://huggingface.co/settings/tokens
OPENAI_API_KEY=
OPENAI_API_BASE=https://router.huggingface.co/v1

# NVIDIA (build.nvidia.com / NIM). Key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Neuro-SAN server connection -------------------------------------------
NEURO_SAN_HOST=127.0.0.1
NEURO_SAN_HTTP_PORT=8080
NEURO_SAN_CONNECT_TIMEOUT=20
NEURO_SAN_STREAM_TIMEOUT=180

# --- ONRAMP data ------------------------------------------------------------
# ONRAMP_DB=./data/onramp.db
