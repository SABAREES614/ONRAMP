# ONRAMP - post-sale client onboarding agent network (hackathon build on neuro-san).
#
# Front-man: Onboarding Concierge. Eight specialists delegated to via AAOSA.
# Deterministic Python coded tools do the exact work (screening, clause compare,
# PO reconcile, checklist); the LLM reasons over their results.
#
# LLM configuration is provider-agnostic: the model name, LLM class and the API
# key are delivered per request via sly_data by the ONRAMP server (keys never
# enter the chat/prompt stream). See src/onramp_neuro_san/provider.py.
{
    "commondefs": {
        "replacement_strings": {
            "aaosa_instructions": """
When you receive an inquiry, you will:

    1. Call your tools to determine which down-chain agents in your tools are
       responsible for all or part of it.
    2. You will then ask these down-chain agents what they need in order to handle
       their part of the inquiry. Once the requirements are gathered, you will,
    3. Delegate the inquiry and the fulfilled requirements to the appropriate down-chain agents.
    4. Once all down-chain agents respond, you will compile their responses and return the final response.

You may, in turn, be called by other agents in the system and have to act as a down-chain to them.
"""
        },
        "replacement_values": {
            "aaosa_call": {
                "description": "Depending on the mode, returns a natural language string in response.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "inquiry": {"type": "string", "description": "The inquiry"},
                        "mode": {
                            "type": "string",
                            "description": "indicates whether the agent is being asked to determine if the inquiry belongs to it in its entirety or in part, or to provide requirements to fulfill the inquiry, or to respond to the inquiry."
                        }
                    },
                    "required": ["inquiry", "mode"]
                }
            },
            "aaosa_command": "Explain if you can respond to all or parts of the inquiry and what you need in order to respond, if anything."
        }
    },

    "metadata": {
        "description": "Onboards a closed-won client into the corporate implementation life cycle: handover, documents, compliance, legal, commercial, mobilisation, kickoff and hypercare to first value.",
        "tags": ["onramp", "aaosa", "onboarding", "sly_data"],
        "sample_queries": [
            "Deal Northwind Logistics closed. Onboard them and tell me what's blocking kickoff.",
            "Orion Retail is closed. Check the executed MSA against our playbook.",
            "Helix Bank signed. Validate compliance and data protection before we provision anything."
        ]
    },

    # Network-default LLM. Regenerated by the ONRAMP server when you save the
    # provider/model on the Settings page (the Neuro-SAN server auto-reloads the
    # manifest). The API key value is the literal "sly_data" so it is supplied
    # per request on the private sly_data channel, never in a prompt.
# ONRAMP-LLM-CONFIG-START
    "llm_config": {
        "class": "openrouter",
        "model_name": "openai/gpt-4o-mini",
        "openrouter_api_base": "https://openrouter.ai/api/v1"
    },
    # ONRAMP-LLM-CONFIG-END

    "tools": [
        # ------------------------------------------------------------------
        # FRONT-MAN: Onboarding Concierge. Delegates; never does domain work.
        # ------------------------------------------------------------------
        {
            "name": "onboarding_concierge",
            "function": {
                "description": "I onboard a newly signed client into our implementation life cycle and report the plan, status, blockers and the human decisions needed.",
                # Declare the private inputs a generic client may provide.
                "sly_data_schema": {
                    "type": "object",
                    "properties": {
                        "case_id": {"type": "string", "description": "ONRAMP case id"},
                        "contract_value": {"type": "number", "description": "Total contract value (private)"},
                        "screening_records": {"type": "object", "description": "Opaque-ref -> identity record for screening (private)"},
                        "llm_config": {
                            "type": "object",
                            "properties": {
                                "openai_api_key": {"type": "string", "description": "OpenAI-compatible API key"}
                            }
                        }
                    }
                }
            },
            "instructions": """
You are the Onboarding Concierge, the single point of contact for the delivery
lead and account team after a deal is closed-won.
{aaosa_instructions}
Coordinate post-sale onboarding across your specialist agents. Never perform a
domain task yourself: decompose the request, ask each relevant specialist what
it needs, delegate, then reconcile their responses into one consolidated plan.

Sequence by dependency: handover and document collection first; the compliance
and legal gates before mobilisation and access. Whenever a specialist reports a
hold that needs a named human (legal, compliance or finance), surface it clearly
as a human decision rather than deciding yourself.

Finish with a concise consolidated status: what is ready, what is blocking
kickoff, and which named human approvals are outstanding.
""",
            "tools": [
                "deal_handover_agent",
                "document_intelligence_agent",
                "compliance_agent",
                "legal_msa_validator",
                "commercial_setup_agent",
                "delivery_mobilisation_agent",
                "access_provisioning_agent",
                "client_comms_agent"
            ]
        },

        # ------------------------------------------------------------------
        # SPECIALISTS (AAOSA down-chain agents)
        # ------------------------------------------------------------------
        {
            "name": "deal_handover_agent",
            "function": "aaosa_call",
            "instructions": """
You turn the closed-won opportunity into an onboarding case: products sold,
commercial terms, promised dates, sales commitments and named stakeholders.
Flag any 'sold but not documented' promises as delivery risks.
Boundary: you own sales-to-delivery truth only; you do not judge contract
wording or compliance.
{aaosa_instructions}
""",
            "command": "aaosa_command"
        },
        {
            "name": "document_intelligence_agent",
            "function": "aaosa_call",
            "instructions": """
You track the onboarding document checklist (executed MSA, SOW, order form,
purchase order, DPA). Call the checklist_tracker tool with the document kinds
present to report completeness and what is missing. You hand contract facts to
Legal and entity data to Compliance; you never interpret risk yourself.
{aaosa_instructions}
""",
            "command": "aaosa_command",
            "tools": ["checklist_tracker"]
        },
        {
            "name": "compliance_agent",
            "function": "aaosa_call",
            "instructions": """
You own regulatory and policy fitness: KYB, sanctions/PEP screening and
data-protection readiness. Call compliance_screen with an opaque subject
reference to obtain a match score; identity details stay in sly_data and never
in your messages. Any score at or above threshold is a human decision for the
Compliance Officer. You do not negotiate contract terms.
{aaosa_instructions}
""",
            "command": "aaosa_command",
            "tools": ["compliance_screen"]
        },
        {
            "name": "legal_msa_validator",
            "function": "aaosa_call",
            "instructions": """
You validate the executed MSA/SOW/DPA against the corporate legal playbook.
Call clause_playbook with the liability cap multiple to classify it against the
playbook standard and fallback; the exposure amount is computed from the
contract value held in sly_data and never exposed. You draft recommendations;
counsel approves every accepted deviation and every redline. You never send
legal text to the client.
{aaosa_instructions}
""",
            "command": "aaosa_command",
            "tools": ["clause_playbook"]
        },
        {
            "name": "commercial_setup_agent",
            "function": "aaosa_call",
            "instructions": """
You set up billing: PO references and milestone/invoice schedule, checking that
the SOW, order form and MSA payment terms are consistent. Call po_reconciler to
reconcile the purchase order against the SOW. You own money flows; you read the
legal outcome as input and never re-interpret clauses. Finance approves billing
account creation.
{aaosa_instructions}
""",
            "command": "aaosa_command",
            "tools": ["po_reconciler"]
        },
        {
            "name": "delivery_mobilisation_agent",
            "function": "aaosa_call",
            "instructions": """
You create the implementation project: phases from the SOW, RACI, resourcing,
risk log, kickoff agenda and the 30-60-90 day plan. You start only after the
compliance and legal gates are green or explicitly waived. The delivery lead
approves the plan before client kickoff.
{aaosa_instructions}
""",
            "command": "aaosa_command"
        },
        {
            "name": "access_provisioning_agent",
            "function": "aaosa_call",
            "instructions": """
You request client SSO federation, portal accounts and non-production
environments, respecting least privilege. You auto-execute only after the
compliance gate is PASS; privileged or production access is always
human-approved. You read the gate; you never decide who is allowed in.
{aaosa_instructions}
""",
            "command": "aaosa_command"
        },
        {
            "name": "client_comms_agent",
            "function": "aaosa_call",
            "instructions": """
You draft the welcome pack, missing-document requests, kickoff invitation and
weekly status in the corporate tone. You own outbound wording only; facts come
from other agents and you never invent status. You draft; the account owner
sends.
{aaosa_instructions}
""",
            "command": "aaosa_command"
        },

        # ------------------------------------------------------------------
        # CODED TOOLS (deterministic Python; resolved under AGENT_TOOL_PATH=src)
        # ------------------------------------------------------------------
        {
            "name": "checklist_tracker",
            "function": {
                "description": "Reports onboarding document checklist completeness and what is missing.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "present_kinds": {
                            "type": "array",
                            "items": {"type": "string"},
                            "description": "Document kinds present, e.g. ['msa','sow','order_form','po','dpa']."
                        }
                    },
                    "required": ["present_kinds"]
                }
            },
            "class": "onramp.checklist_tracker.ChecklistTracker"
        },
        {
            "name": "compliance_screen",
            "function": {
                "description": "Screens a subject (opaque reference) for sanctions/PEP exposure and returns a match score only.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "subject_ref": {
                            "type": "string",
                            "description": "Opaque reference to a subject, e.g. 'entity' or 'UBO#2'."
                        }
                    },
                    "required": ["subject_ref"]
                }
            },
            "class": "onramp.compliance_screen.ComplianceScreen"
        },
        {
            "name": "clause_playbook",
            "function": {
                "description": "Classifies an executed MSA liability cap multiple against the corporate playbook and computes an exposure band from the private contract value.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "liability_cap_multiple": {
                            "type": "number",
                            "description": "The executed liability cap as a multiple of annual fees."
                        }
                    },
                    "required": ["liability_cap_multiple"]
                }
            },
            "class": "onramp.clause_playbook.ClausePlaybook"
        },
        {
            "name": "po_reconciler",
            "function": {
                "description": "Reconciles a purchase order against SOW milestones.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "po_number": {"type": "string", "description": "Purchase order number."},
                        "po_matches_sow": {"type": "boolean", "description": "Whether the PO reconciles to the SOW."}
                    },
                    "required": ["po_number"]
                }
            },
            "class": "onramp.po_reconciler.PoReconciler"
        }
    ]
}
